# Isolated V2 runtime
RMV2_APP_HOST=127.0.0.1
RMV2_APP_PORT=8001
RMV2_INSTALL_DIR=~/RoleModelHelperV2
RMV2_SERVICE_NAME=rolemodel-helper-v2.service
RMV2_DATABASE_DSN=postgresql://rolemodel_v2_app@127.0.0.1:5432/rolemodel
RMV2_MIGRATION_DSN=postgresql://rolemodel_v2_owner@127.0.0.1:5432/rolemodel
RMV2_DATABASE_APP_ROLE=rolemodel_v2_app
RMV2_STATE_SCHEMA=rolemodel_v2_runtime
RMV2_CATALOG_BACKEND=postgres
RMV2_CATALOG_DSN=postgresql://rolemodel_v2_app@127.0.0.1:5432/rolemodel
RMV2_CATALOG_SCHEMA=rolemodel_v2_catalog
RMV2_CATALOG_READER_ROLE=rolemodel_v2_app
RMV2_CATALOG_WRITER_ROLE=rolemodel_v2_catalog_writer
# Dedicated job role: SELECT on V1 catalog, DML on V2 catalog only.
RMV2_CATALOG_IMPORT_DSN=postgresql://rolemodel_v2_catalog_writer@127.0.0.1:5432/rolemodel

# Explicit V1 collision guards
RMV2_V1_APP_PORT=8000
RMV2_V1_INSTALL_DIR=~/RoleModelHelper2
# Installer-only override when V1 certificate paths are in another env file.
RMV2_V1_ENV_FILE=
RMV2_V1_SERVICE_NAME=rolemodel-helper.service
RMV2_V1_STATE_SCHEMA=public
RMV2_V1_CATALOG_SCHEMA=public

# Optional exact version pin. Empty means the active PostgreSQL release.
RMV2_CATALOG_VERSION=
RMV2_CATALOG_REFRESH_SECONDS=5

# Local tests only: set CATALOG_BACKEND=json and both values explicitly.
RMV2_CATALOG_PATH=

# GigaChat. Leave all credentials empty for deterministic-only demo mode.
RMV2_GIGACHAT_ENDPOINT=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
RMV2_GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
RMV2_GIGACHAT_SCOPE=GIGACHAT_API_PERS
RMV2_GIGACHAT_MODEL=GigaChat-2-Max
RMV2_GIGACHAT_ACCESS_TOKEN=
RMV2_GIGACHAT_AUTH_KEY=
RMV2_GIGACHAT_CLIENT_ID=
RMV2_GIGACHAT_CLIENT_SECRET=
RMV2_GIGACHAT_CERT_FILE=
RMV2_GIGACHAT_KEY_FILE=
RMV2_GIGACHAT_CA_BUNDLE=
RMV2_TLS_VERIFY=true
RMV2_PLANNER_DEADLINE_MS=12000
